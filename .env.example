# Umgebungsvariablen für unifi-cam-proxy-redalert
#
# Nur für Entwicklungs-/Test-Skripte (test-dev/) benötigt.
# Die Hauptanwendung (Unifi/, Web/) benötigt keine Env-Variablen.

# UFP_ROOT_PASS: Root-Passwort des UniFi Protect Controllers
# Wird von test-dev/parser/dev_parser_unifi_protect_messages.py verwendet,
# um direkte Verbindungen zum Controller herzustellen.
# UFP_ROOT_PASS=changeme
